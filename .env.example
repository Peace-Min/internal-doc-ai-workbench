# Copy to .env locally; never commit internal values.
WB_PORT=4318
WB_MODE=mock
# Optional fixed pairing token, minimum 24 characters; otherwise generated in private/runtime.json.
# WB_TOKEN=
# Change only after confirming the actual desktop plugin origin.
WB_PLUGIN_ORIGINS=null,file://
# OpenAI-compatible internal endpoint (used ONLY when WB_MODE=openai-compatible).
# WB_LLM_URL=http://llm.example.invalid/v1/chat/completions
# WB_LLM_MODEL=internal-model
# WB_LLM_KEY=
# Anthropic Messages-compatible gateway (e.g. the endpoint used by Claude Code).
# WB_MODE=anthropic-compatible
# WB_CLAUDE_CONFIG=C:\Private\config.json
# WB_CLAUDE_MODEL_TIER=sonnet
# Optional overrides: WB_LLM_URL is the full /v1/messages endpoint.
# WB_LLM_AUTH=bearer
# WB_LLM_MAX_TOKENS=2048
# Network probe timeout only (1..30000 ms); diagnose-llm sends fixed synthetic text.
# WB_PROBE_TIMEOUT_MS=10000
